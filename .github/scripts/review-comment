#!/usr/bin/env python3
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
"""Write the review comment of an enrollment pull request, as build.yaml's comment job posts it.

    review-comment [--review <comment.md>] [--checks <checks.md>] [--head <sha>] [--run <url>] [--previous <comment>]

It prints the comment: the marker that build.yaml's comment job finds it by, a metadata line, what this script writes
(the footer, a notice when the review is not current or did not run, a note where a text was cut), the report of
tools/check --checks in a fenced block, and last the review's comment to the maintainer. The review's text comes from a
model that read the pull request, and the checks text from the project's source, so each is screened on its own: a text
that holds what looks like a credential is refused (and the other kept), each is cut to a length that GitHub takes, and
each loses any HTML comment that names this script.

Neither text is otherwise changed, character for character: Markdown code in them reaches GitHub as written. What they
cannot reach is what this script writes. It all comes before them; the review comes last, so nothing it leaves open
(an HTML comment, a tag, a code fence) has anything after it to hide; and the checks report sits in a fenced block
whose fence is longer than any run of backticks in it, so nothing in the report can close it early or be read as HTML.

The commit the review is of and whether there is a review live in the metadata line only, the second line of the
comment, which this script alone writes. They are never read from the body. So with --previous and no usable review
(the review of this push did not finish, or wrote nothing, or wrote what is refused), it keeps the comment already
posted, unchanged, below a metadata line and a notice that say it is not current, naming the commit it is of and the
commit that had no review.
"""
import argparse
import pathlib
import re
import sys

MARKER = "<!-- oss-verify-review -->"
HEADING = "## Enrollment review"
# GitHub refuses a comment over 65,536 characters; stay below with a margin for the pieces this script adds.
MAX_COMMENT = 65_000
MAX_REVIEW = 40_000
MAX_CHECKS = 20_000
# What a credential looks like: a GitHub identity token (a JWT), an Anthropic token or key, a GitHub token. The scan
# below reads each run of token characters once, rather than a regular expression of these four alternatives, whose
# JWT branch reads the rest of the text again at every "eyJ" that no dot follows.
RUN = re.compile(r"[A-Za-z0-9_-]+")
GITHUB = re.compile(r"gh[opsu]_")
GITHUB_PAT = re.compile(r"github_pat_")
GITHUB_BODY = re.compile(r"[A-Za-z0-9]{20}")
GITHUB_PAT_BODY = re.compile(r"[A-Za-z0-9_]{20}")
ANTHROPIC = "sk-ant-"
JWT = "eyJ"
# The metadata line, always the second line of the comment and written by this script alone: the format version, the
# commit the review is of, and the status (review: a review is here; none: there is none; stale: a kept review that a
# later push's review did not replace). It is the only place the status and the commit are read from.
META = re.compile(r"^<!-- oss-verify-meta v=1"
                  r"(?: head=(?P<head>[0-9a-f]{7,40}))?"
                  r" status=(?P<status>review|none|stale) -->$")
# The no-review paragraph that this script wrote before the metadata line existed, in full: a legacy comment that is
# exactly this has no review to keep. Any other legacy text is a review.
LEGACY_NO_REVIEW = re.compile(r"The review agent did not run on this push: [^\n]*\. "
                              r"A person at Theorem reviews the enrollment\.")


def neutralize(text):
    """text with each HTML comment that names this script's prefix replaced by a space, so that text this script did not
    write never reads, to a person, as one of its own lines (the metadata is read from line 2 only, so this is not what
    keeps it safe). One forward scan, linear in the text: a comment runs from <!-- to the first --> after it, as in
    HTML, and the space left in its place cannot join the text around it into a new one. Nothing else changes: a <!--
    that nothing closes is left as it is, because the review comes last and the checks are fenced, so it hides nothing
    of this script's."""
    out, at = [], 0
    while (start := text.find("<!--", at)) != -1:
        end = text.find("-->", start + 4)
        if end == -1:
            break
        span = text[start:end + 3]
        out += [text[at:start], " " if "oss-verify" in span.lower() else span]
        at = end + 3
    return "".join(out) + text[at:]


def credential(text):
    """Whether text holds what looks like a credential. One pass: every check below is bounded, and each run of token
    characters is read a fixed number of times, so the cost is linear in the text."""
    runs = [(found.start(), found.group()) for found in RUN.finditer(text)]
    for index, (start, run) in enumerate(runs):
        # An Anthropic token or key: sk-ant- and at least 8 more token characters, all inside this run. The first
        # occurrence has the most of the run after it, so no later one needs trying.
        at = run.find(ANTHROPIC)
        if at != -1 and len(run) - at - len(ANTHROPIC) >= 8:
            return True
        # A GitHub token: its prefix and 20 more characters of the right kind, tried at each prefix (an earlier one can
        # fail where a later one matches). Each try reads at most 20 characters, and prefixes do not overlap.
        for prefix, body in ((GITHUB, GITHUB_BODY), (GITHUB_PAT, GITHUB_PAT_BODY)):
            for found in prefix.finditer(run):
                if body.match(run, found.end()):
                    return True
        # A JWT: eyJ, at least 10 more token characters, a dot, and at least 10 more. A dot ends a run, so the dot can
        # only be the character after this run, and the second part can only be the run after it.
        at = run.find(JWT)
        after = start + len(run)
        if (at != -1 and len(run) - at - len(JWT) >= 10 and text[after:after + 1] == "."
                and index + 1 < len(runs) and runs[index + 1][0] == after + 1 and len(runs[index + 1][1]) >= 10):
            return True
    return False


def fence(text):
    """text in a fenced code block that nothing in it can close or leave: the fence is one backtick longer than the
    longest run of backticks in it, and GitHub reads nothing inside a code block as Markdown or HTML."""
    longest = max((len(run) for run in re.findall(r"`+", text)), default=0)
    bar = "`" * max(3, longest + 1)
    return f"{bar}text\n{text}\n{bar}"


def meta_line(head, status):
    return f"<!-- oss-verify-meta v=1{f' head={head}' if head else ''} status={status} -->"


def read_previous(previous):
    """The posted comment's (status, head, body): status/head from the metadata line only, None when it is legacy."""
    lines = previous.replace("\r\n", "\n").split("\n")
    status = head = None
    if len(lines) >= 2 and lines[0].strip() == MARKER:
        match = META.match(lines[1].strip())
        if match:
            status, head = match.group("status"), match.group("head")
    start = previous.find("\n" + HEADING + "\n")
    body = previous[start + len(HEADING) + 2:] if start != -1 else previous.replace(MARKER, "")
    return status, head, body.strip()


FOOTER = ("<sub>Claude wrote this review, following `.claude/skills/review-enrollment/SKILL.md`, and "
          "`tools/check --checks` measured the checks. It can be wrong. {of}Each push replaces it, or marks it not "
          "current if the push's review does not finish. It decides nothing: a person at Theorem reviews the "
          "enrollment.</sub>")
CHECKS_SUMMARY = "<details><summary>What the breakage and coverage checks measured</summary>"


def assemble(head, status, notes, checks="", review="", where="the rest is in the review job's log",
             review_limit=MAX_REVIEW):
    """The comment, at most MAX_COMMENT characters: the marker and metadata, the heading, the notes (what this script
    writes), the checks report fenced, and the review last. Only the checks and the review are cut, by slicing, and a
    note before them says where; nothing else in them changes."""
    notes = list(notes)
    checks, review = checks.strip(), review.strip()
    if len(checks) > MAX_CHECKS:
        checks = checks[:MAX_CHECKS].rstrip()
        notes.append(f"The checks report is cut at {MAX_CHECKS:,} characters: the rest is in the Build check's "
                     "summary.")
    blocks = [f"{MARKER}\n{meta_line(head, status)}", HEADING, *notes]
    if checks:
        blocks.append(f"{CHECKS_SUMMARY}\n\n{fence(checks)}\n\n</details>")
    review_note = "The review is cut at {:,} characters: " + where + "."
    # Room for the review: what is left once every other block, the note it may need and the joins are counted.
    room = MAX_COMMENT - len("\n\n".join(blocks)) - len(review_note.format(10 ** 9)) - 6
    limit = max(0, min(review_limit, room))
    if len(review) > limit:
        review = review[:limit].rstrip()
        blocks.insert(2 + len(notes), review_note.format(limit))
    if review:
        blocks.append(review)
    return "\n\n".join(blocks) + "\n"


def not_current(previous, head, run):
    """The comment already posted, kept but marked not the review of head; None when it holds no review to keep."""
    status, of_head, body = read_previous(previous)
    if status == "stale":
        # Drop the notice this script put first last time, so the marks do not stack; the old comment follows it.
        body = body.split("\n\n", 1)[1].strip() if "\n\n" in body else ""
    if status == "none" or not body.strip():
        return None
    if status is None:
        # Legacy, before the metadata line: keep it unless its first paragraph is exactly the no-review sentence this
        # script used to write.
        if LEGACY_NO_REVIEW.fullmatch(body.split("\n\n", 1)[0].strip()):
            return None
        of_head = None
    of = f"`{of_head[:7]}`" if of_head else "an earlier commit"
    this = f"`{head[:7]}`" if head else "the last push"
    where = f" ([the run]({run}))" if run else ""
    note = (f"**Not current:** this is the review of {of}. The review of {this} did not finish with a review that "
            f"can be posted{where}. A person at Theorem reviews the enrollment.")
    # The old comment, footer, checks and review as it was posted, goes last and unchanged, so the notice above it
    # stays visible whatever it holds; only its length is cut, if it must be.
    return assemble(of_head, "stale", [note], review=body, where="the rest is in an earlier run of the review job",
                    review_limit=MAX_COMMENT)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--review", type=pathlib.Path, help="the review's comment.md")
    parser.add_argument("--checks", type=pathlib.Path, help="the report of tools/check --checks")
    parser.add_argument("--head", default="", help="the commit of the pull request that this run is of")
    parser.add_argument("--run", default="", help="the URL of this run")
    parser.add_argument("--previous", type=pathlib.Path, help="the comment already posted, kept if there is no review")
    options = parser.parse_args()
    head = options.head if re.fullmatch(r"[0-9a-f]{7,40}", options.head) else ""
    run = options.run if re.fullmatch(r"https://[A-Za-z0-9./_-]+", options.run) else ""

    review = options.review.read_text(encoding="utf-8", errors="replace") if options.review else ""
    why = ""
    if credential(review):
        review, why = "", "its text held what looks like a credential, so it was not posted"
    review = neutralize(review).strip()
    # No usable review (none, blank, refused, or only this script's markers): keep the one already posted, if any.
    if options.previous and not review:
        previous = options.previous.read_text(encoding="utf-8", errors="replace")
        if credential(previous):
            why = why or "it wrote no comment"
            why += ", and the last review held what looks like a credential, so it is not kept"
        else:
            kept = not_current(previous, head, run)
            if kept is not None:
                sys.stdout.write(kept)
                return 0
    of = f"It is the review of `{head[:7]}`. " if head else ""
    if review:
        notes, status = [FOOTER.format(of=of)], "review"
    else:
        this = f" (`{head[:7]}`)" if head else ""
        where = f" ([the run]({run}))" if run else ""
        notes = [f"The review agent did not run on this push{this}: {why or 'it wrote no comment'}{where}. "
                 "A person at Theorem reviews the enrollment.", FOOTER.format(of=of)]
        status = "none"
    checks = options.checks.read_text(encoding="utf-8", errors="replace") if options.checks else ""
    if credential(checks):
        # The checks text comes from the project's source: refused on its own, so a safe review is still posted.
        checks = ("The report held what looks like a credential, so it was not posted. It is in the Build check's "
                  "summary.")
    sys.stdout.write(assemble(head, status, notes, checks=neutralize(checks), review=review))
    return 0


if __name__ == "__main__":
    sys.exit(main())
